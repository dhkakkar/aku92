###############################################################################
# AKU 92 — Production .env template for GoDaddy cPanel + MySQL
#
# Copy this file to .env on the server and fill the gaps marked ⬅.
# After saving the file run:
#     php artisan key:generate   (only if APP_KEY is blank)
#     php artisan config:clear
###############################################################################

APP_NAME="AKU 92"
APP_ENV=production
APP_KEY=                                # ⬅ generated automatically by `php artisan key:generate`
APP_DEBUG=false
APP_URL=https://aku92.com
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── MySQL on GoDaddy cPanel ─────────────────────────────────────────────────
# Create the DB in cPanel → MySQL Databases. The full name usually looks like
# cpaneluser_aku92 (cpanel prefix + your db name) and same for username.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                            # ⬅ e.g. aku92_main (cPanel full name)
DB_USERNAME=                            # ⬅ e.g. aku92_user
DB_PASSWORD=                            # ⬅ your DB password

# ─── Sessions & cache (file driver — safe default on shared hosting) ─────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

# ─── Gmail SMTP (notifications) ──────────────────────────────────────────────
# Same Gmail App Password approach we use in dev. Keep MAIL_PASSWORD as the
# 16-char app password generated from myaccount.google.com/apppasswords.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=aku92delhi@gmail.com
MAIL_PASSWORD=                          # ⬅ 16-char Gmail App Password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="aku92delhi@gmail.com"
MAIL_FROM_NAME="AKU 92"

# Comma-separated list of emails that receive every OPD form submission.
OPD_NOTIFICATION_EMAIL=advocatemjain1967@gmail.com

# ─── Misc (kept for parity with framework defaults) ──────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
